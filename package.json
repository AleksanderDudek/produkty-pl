{
  "name": "produkty-pl",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "data:taxonomies": "tsx scripts/fetch-taxonomies.ts",
    "data:prices": "tsx scripts/fetch-prices.ts",
    "data:prepare": "tsx scripts/prepare-data.ts",
